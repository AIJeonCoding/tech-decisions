# LLM
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Chat 비전 모드 — 이미지 첨부 시 Ollama VL 모델 사용 (텍스트는 기존 qwen3 그대로).
# 같은 Funnel 사용. Mac에서 `ollama pull qwen2.5vl:3b` 미리 받아두면 됨.
OLLAMA_VISION_MODEL=gemma3:4b

# DB
DATABASE_URL=postgresql://user:pass@host:5432/tech_decisions
DIRECT_URL=postgresql://user:pass@host:5432/tech_decisions  # Drizzle migrations

# Cost guards
LLM_DAILY_BUDGET_USD=2

# Crawler
CRAWLER_USER_AGENT="tech-decisions-bot/0.1 (+https://tech-decisions.app)"

# Web — 두 URL 분리 배포 토글
# - 'true' (기본) — 포트폴리오 모드: my-project 노출 + robots disallow /  (검색엔진 차단)
# - 'false'       — 공개 SEO 모드: my-project 제외 + robots allow / (Google 인덱싱)
INCLUDE_MY_PROJECT=true
NEXT_PUBLIC_SITE_URL=https://tech-decisions.app

# Local RAG (Ollama). Off by default. Turn on only in local dev — Vercel
# functions can't run Ollama.
LOCAL_LLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GENERATE_MODEL=qwen3:1.7b

# Cloud LLM mode — Vercel function calls Ollama through Tailscale Funnel +
# Caddy reverse proxy on a personal Mac. Caddy verifies Bearer token before
# forwarding to localhost-bound Ollama. Off by default — flip to true after
# Tailscale/Caddy setup is verified locally (see docs/LOCAL_RAG.md §Cloud).
CLOUD_LLM_ENABLED=false
# When CLOUD_LLM_ENABLED=true, set OLLAMA_URL to the Funnel domain instead:
#   OLLAMA_URL=https://<machine>.<tailnet>.ts.net
# LLM_BEARER_TOKEN must match the one Caddy expects (Mac ~/.config/caddy/env).
LLM_BEARER_TOKEN=
