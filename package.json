{
  "name": "tech-decisions",
  "private": true,
  "version": "0.0.1",
  "description": "한국 빅테크 엔지니어링 의사결정 비교·검색 서비스",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "web",
    "crawler",
    "db"
  ],
  "scripts": {
    "dev": "pnpm --filter @td/web dev",
    "build": "pnpm --filter @td/db db:reset && pnpm --filter @td/web build",
    "crawl": "pnpm --filter @td/crawler start",
    "embed": "pnpm --filter @td/crawler embed",
    "db:init": "pnpm --filter @td/db db:init",
    "db:seed": "pnpm --filter @td/db db:seed",
    "db:seed-cells": "pnpm --filter @td/db db:seed-cells",
    "db:seed-articles": "pnpm --filter @td/db db:seed-articles",
    "db:reset": "pnpm --filter @td/db db:reset",
    "db:studio": "pnpm --filter @td/db studio"
  }
}
